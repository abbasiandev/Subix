# Copy to backend/.env.guide-sync. Keep the private reference host out of git.
GUIDE_SOURCE_URL=https://your-private-reference-host.example
GUIDE_SOURCE_PATHS=/blog
# Used only with: python -m scripts.sync_guides --ai
OPENAI_API_KEY=replace_with_private_key
AI_MODEL=gpt-4o-mini
