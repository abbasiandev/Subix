# Telegram (optional; leave disabled until the bot is configured)
BOT_TOKEN=
ENABLE_WEBHOOK=false
WEBHOOK_URL=https://fluxo.ir/webhook
# Set ENABLE_WEBHOOK=true and provide BOT_TOKEN before enabling Telegram.

# JWT
SECRET_KEY=change_this_to_random_64_char_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Turso
TURSO_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_token_here

# App
APP_NAME=Fluxo
FRONTEND_URL=https://fluxo.ir
DEBUG=false

# Admin (local price editor at /admin/)
ADMIN_SECRET=change_this_to_a_long_random_string

# SMS.ir (configure only in the private .env)
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=0
SMS_IR_PARAMETER_NAME=Code

# Private price sync (keep this in .env.price-sync, never in frontend code)
# PRICE_SOURCE_URL=https://your-private-reference-host.example
# PRICE_SOURCE_PATHS=/
# PRICE_SYNC_MIN_SCORE=0.62
# PRICE_SYNC_MIN_MATCHES=1
